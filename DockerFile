# Dockerfile
# Production image for the Housing Price Prediction API.
# Bundles the trained model (models/model.pkl) into the image itself,
# so the container is fully self-contained and portable to any host
# that can run Docker - including an AWS EC2 instance (plain Docker
# or Docker running behind ECS/EC2 launch type).

FROM python:3.12-slim AS base

# Prevent Python from writing .pyc files / buffering stdout, keep pip quiet
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /code

# System deps needed to build scikit-learn / pandas wheels on slim base images
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies first for better Docker layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copy application code, pipeline source (logger/exception used by app/main.py),
# and the trained model artifact - the model ships INSIDE the image.
COPY app/ ./app/
COPY src/ ./src/
COPY models/model.pkl ./models/model.pkl

ENV MODEL_PATH=models/model.pkl

# Run as a non-root user - standard hardening for EC2-hosted containers
RUN useradd --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /code
USER appuser

EXPOSE 8000

# EC2 / ECS / any orchestrator can poll this to know the container is ready
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Bind to 0.0.0.0 so the API is reachable from outside the container
# (required for EC2 port mapping / security-group access).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]